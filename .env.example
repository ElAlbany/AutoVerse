# Copy to an ignored .env / .env.local. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
APP_URL=http://localhost:3000

# Optional sandbox payments. Live Stripe keys are deliberately rejected.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Run /api/maintenance every five minutes with Authorization: Bearer <secret>.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
RESEND_API_KEY=
EMAIL_FROM=AutoVerse <onboarding@resend.dev>
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
